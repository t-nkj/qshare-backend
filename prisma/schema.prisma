generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

model Device {
    id         String      @id @db.Char(36)
    userId     String      @map("user_id") @db.VarChar(64)
    name       String      @db.VarChar(64)
    tokenHash  Bytes       @unique(map: "uq_devices_token_hash") @map("token_hash") @db.Binary(32)
    createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(3)
    updatedAt  DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
    lastUsedAt DateTime?   @map("last_used_at") @db.DateTime(3)
    sharedUrls SharedUrl[]

    @@index([userId, createdAt, id], map: "idx_devices_user")
    @@map("devices")
}

model SharedUrl {
    id               String   @id @db.Char(36)
    userId           String   @map("user_id") @db.VarChar(64)
    sourceDeviceId   String?  @map("source_device_id") @db.Char(36)
    sourceDeviceName String   @map("source_device_name") @db.VarChar(64)
    url              String   @db.VarChar(4096)
    createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
    expiresAt        DateTime @map("expires_at") @db.DateTime(3)
    sourceDevice     Device?  @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_shared_urls_user_history")
    @@index([expiresAt], map: "idx_shared_urls_expiry")
    @@map("shared_urls")
}
